# ==============================================================================
# Story Teacher - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env.local' or configure in your deployment platform.
# NEVER commit production API keys, credentials, or tokens to version control.

# Google Gemini API Key (optional):
# Used for limitless dynamic AI fairy tale synthesis on arbitrary concepts.
# When unset or empty, Story Teacher automatically runs in zero-configuration
# offline mode powered by the procedural story weaver and curated library.
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Application environment
VITE_APP_ENV=development

# Optional public base URL
VITE_PUBLIC_BASE_URL=http://localhost:5173
